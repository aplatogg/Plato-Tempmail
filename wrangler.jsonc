{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plato-tempmail",
  "account_id": "REPLACE_WITH_YOUR_ACCOUNT_ID",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "mail.example.com", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "send_email": [
    {
      "name": "RESET_EMAIL",
      "destination_address": "owner@example.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plato-tempmail-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Halfeast-Mail",
    "MAIL_DOMAIN": "example.com",
    "PUBLIC_ORIGIN": "https://mail.example.com",
    "ADMIN_USERNAME": "operator",
    "MESSAGE_RETENTION_DAYS": "7",
    "RESET_EMAIL_TO": "owner@example.com"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
