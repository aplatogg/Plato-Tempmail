{
  "name": "plato-tempmail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "bootstrap:local": "node scripts/bootstrap-local.mjs",
    "password:hash": "node scripts/password-hash.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "npm run preflight && wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "playwright test -c playwright.integration.config.ts",
    "test:tooling": "node --test tests/tooling.test.mjs",
    "preflight": "node scripts/preflight.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run preflight && wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.8",
    "html-to-text": "10.0.1",
    "postal-mime": "3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vitest-plugin": "1.2.3",
    "@cloudflare/workers-types": "5.20260923.1",
    "@playwright/test": "1.63.0",
    "@types/html-to-text": "9.0.4",
    "@types/node": "26.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.136.3"
  }
}
