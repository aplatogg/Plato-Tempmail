{
  "name": "plato-mail",
  "version": "0.2.0",
  "description": "Self-hosted multi-user temporary email on Cloudflare Workers, D1 and Email Routing, with API keys for automation.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --local --ip 127.0.0.1 --port 8787",
    "bootstrap:local": "node scripts/bootstrap-local.mjs",
    "password:hash": "node scripts/password-hash.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:remote": "npm run preflight && wrangler d1 migrations apply DB --remote --config wrangler.local.jsonc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "playwright test -c playwright.integration.config.ts",
    "test:tooling": "node --test tests/tooling.test.mjs tests/secrets.test.mjs tests/client-guards.test.mjs",
    "preflight": "node scripts/preflight.mjs --config wrangler.local.jsonc",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.local.jsonc",
    "build:ci": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "deploy": "npm run preflight && wrangler deploy --config wrangler.local.jsonc"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "hono": "4.13.19",
    "html-to-text": "10.0.1",
    "postal-mime": "4.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@playwright/test": "^1.64.1",
    "@types/html-to-text": "9.0.4",
    "@types/node": "^26.6.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
